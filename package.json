{
  "name": "fahan-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --experimental-sqlite server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --experimental-sqlite server/index.mjs --serve-web",
    "test": "node --experimental-sqlite --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
